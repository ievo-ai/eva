# Eva environment variables
# Copy to .env and fill in your tokens
#
# Auth options:
#   CI (GitHub Actions) — GitHub App (ievo-eva) auto-generates short-lived token
#   Local — use a PAT with org-wide access to ievo-ai
#
# One token covers everything: reading issues, creating PRs, publishing evolutions.

# GitHub token (required)
# Fine-grained PAT permissions (all ievo-ai repos):
#   Contents:       Read & Write  (read files, commit patches, push evolutions)
#   Issues:         Read          (collect signals from issues)
#   Pull Requests:  Read & Write  (create PRs with mutations)
#   Actions:        Read & Write  (trigger workflows, read run statuses)
#   Metadata:       Read          (auto-granted)
EVA_GITHUB_TOKEN=ghp_xxxxxxxxxxxxxxxxxxxx

# Sentry auth token (for READING issues from Sentry as a signal source)
# Create at: https://sentry.io/settings/account/api/auth-tokens/
# Scopes: project:read, event:read
# Projects configured in eva.yaml → sources.sentry.extra.projects
EVA_SENTRY_TOKEN=

# Sentry DSN (for Eva's OWN error reporting)
# Get from: Sentry → eva project → Settings → Client Keys (DSN)
# If not set, Eva runs without self-reporting (silent skip)
EVA_SENTRY_DSN=

# Environment tag for Sentry (default: production)
# EVA_ENVIRONMENT=production

# Path to local marketplace repo (default: ../marketplace)
# MARKETPLACE_DIR=../marketplace

# Telegram Bot API token (for community interaction)
# Get from: @BotFather in Telegram
TELEGRAM_BOT_TOKEN=

# Telegram community chat ID (for publishing evolutions + interaction)
TELEGRAM_COMMUNITY_CHAT=

# Telegram forum topic ID for evolution messages (optional)
# TELEGRAM_EVOLUTIONS_TOPIC=

# Anthropic API key (for Eva's community responses via Claude Haiku)
# Create at: https://console.anthropic.com/settings/keys
# Required for DO deployment; optional locally if Claude Code CLI is available
ANTHROPIC_API_KEY=
